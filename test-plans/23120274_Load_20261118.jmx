      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Preflight + durable baseline (ignored control sample)" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters" />
          <stringProp name="filename" />
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">SampleResult.setIgnore()
props.remove('hw05.categoryLoad.class')
props.remove('hw05.categoryLoad.runtime')
try {
    File planDir = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir())
    File projectRoot = new File(props.getProperty('project_root', new File(planDir, '..').canonicalPath))
    Class helper = new GroovyClassLoader(this.class.classLoader).parseClass(new File(projectRoot, 'scripts/category-load-support.groovy'))
    props.put('hw05.categoryLoad.class', helper)
    helper.setup(props, planDir)
    log.info('HW05 preflight passed; main workload now eligible; run manifest initialized')
} catch (Throwable ignored) {
    props.remove('hw05.categoryLoad.runtime')
    log.error('HW05 PREFLIGHT BLOCKED: check approval flags, isolated SUT, free RAM, credentials, CSV and baseline. Main load must not execute.')
    ctx.getEngine().stopTest()
}
</stringProp>
        </JSR223Sampler>
