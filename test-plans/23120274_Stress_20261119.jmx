        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Preflight + durable baseline (ignored control sample)" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">SampleResult.setIgnore()
props.remove(&apos;hw05.categoryStress.class&apos;)
try {
    File planDir = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir())
    File root = new File(props.getProperty(&apos;project_root&apos;, new File(planDir, &apos;..&apos;).canonicalPath))
    def loader = new GroovyClassLoader(this.class.classLoader)
    loader.parseClass(new File(root, &apos;scripts/category-load-support.groovy&apos;))
    Class helper = loader.parseClass(new File(root, &apos;scripts/category-stress-support.groovy&apos;))
    props.put(&apos;hw05.categoryStress.class&apos;, helper)
    helper.setupStress(props, planDir)
    log.info(&apos;HW05 Stress preflight passed; reviewed workload eligible&apos;)
} catch (Throwable ignored) {
    log.error(&apos;HW05 STRESS PREFLIGHT BLOCKED: approvals/RAM/credentials/CSV/baseline/runtime guard&apos;)
    ctx.getEngine().stopTest()
}
</stringProp>
        </JSR223Sampler>
