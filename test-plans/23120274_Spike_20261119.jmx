        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Preflight + durable baseline (ignored control sample)" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters" />
          <stringProp name="filename" />
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">SampleResult.setIgnore()
props.remove('hw05.categorySpike.class')
try {
    File planDir = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir())
    File root = new File(props.getProperty('project_root', new File(planDir, '..').canonicalPath))
    def loader = new GroovyClassLoader(this.class.classLoader)
    loader.parseClass(new File(root, 'scripts/category-load-support.groovy'))
    loader.parseClass(new File(root, 'scripts/category-stress-support.groovy'))
    Class helper = loader.parseClass(new File(root, 'scripts/category-spike-support.groovy'))
    props.put('hw05.categorySpike.class', helper)
    helper.setupSpike(props, planDir)
    log.info('HW05 Spike preflight passed; reviewed workload eligible')
} catch (Throwable ignored) {
    log.error('HW05 SPIKE PREFLIGHT BLOCKED: check approvals, isolation, credentials, RAM, CSV, baseline and required result properties')
    ctx.getEngine().stopTest()
}
</stringProp>
        </JSR223Sampler>
